# EmailJS Configuration
# Get these values from https://emailjs.com/

# Your EmailJS Public Key (found in dashboard > Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your Email Service ID (found in dashboard > Email Services)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Your Email Template ID (found in dashboard > Email Templates)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

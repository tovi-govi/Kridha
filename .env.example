# EmailJS Configuration
# Get these public browser values from https://emailjs.com/

# Your EmailJS Public Key (found in dashboard > Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Your Email Service ID (found in dashboard > Email Services)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id

# Your Email Template ID (found in dashboard > Email Templates)
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
